# Copy to .env (same folder as manage.py) and fill in. .env is not committed to git.

# Gemini API key from https://aistudio.google.com (Get API key).
# Empty = AI suggestions are off.
GEMINI_API_KEY=
# Model name, see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Model for checking the operator's CRM survey against the call (needs more reasoning).
# Empty = the same as GEMINI_MODEL.
GEMINI_COMPARE_MODEL=

# HTTP proxy for Gemini requests only, e.g. http://1.2.3.4:3128.
# Leave empty to connect directly.
GEMINI_PROXY_URL=
GEMINI_PROXY_USERNAME=
GEMINI_PROXY_PASSWORD=
